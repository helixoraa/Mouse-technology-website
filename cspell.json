{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "files": [
    "client/src/**/*.{ts,tsx}",
    "client/index.html",
    "client/build/**/*.{ts,html}",
    "server/prisma/seed-data/**/*.ts",
    "server/src/**/*.ts",
    "docs/**/*.md",
    "README.md",
    "DEPLOY.md"
  ],
  "ignorePaths": ["**/node_modules/**", "**/dist/**", "client/src/lib/password.ts", "server/src/lib/password.ts"],
  "words": [
    "MAOUAJ",
    "Maouaj",
    "maouaj",
    "maouajtechnology",
    "Hossain",
    "hossain",
    "Moallema",
    "moallema",
    "hossainandmoallema",
    "Grupo",
    "Mixco",
    "Zona",
    "Calle",
    "Cristobal",
    "busfare",
    "ecommerce",
    "keyline",
    "focusables",
    "textareas",
    "creds",
    "cand",
    "jwtid",
    "jwtsecret",
    "changeme",
    "pgdata",
    "pgbouncer",
    "UNPOOLED",
    "HSTS",
    "SMIL",
    "wght",
    "TLDS",
    "tlds"
  ],
  "ignoreWords": ["technologys"],
  "flagWords": ["hussain", "muallima", "muallema", "moallima", "hosain", "hussainandmuallima"]
}
