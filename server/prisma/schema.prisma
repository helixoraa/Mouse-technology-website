generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x = the Vercel/AWS Lambda runtime (Node 20+/22). native = your machine (Windows/macOS/Linux).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: DATABASE_URL = pooled connection, DIRECT_URL = direct connection (used by migrations).
  // Locally set DIRECT_URL equal to DATABASE_URL (scripts/prisma.mjs defaults it when unset).
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  password           String
  role               Role         @default(EDITOR)
  active             Boolean      @default(true)
  mustChangePassword Boolean      @default(false)
  /// Bumped on every password/2FA/role/activation change: sessions carrying an older value are rejected.
  sessionVersion     Int          @default(0)
  /// AES-256-GCM encrypted TOTP secret (never returned by the API).
  totpSecretEnc      String?
  /// Secret generated during setup, promoted to totpSecretEnc once a valid code confirms it.
  totpPendingEnc     String?
  totpEnabled        Boolean      @default(false)
  /// Last accepted TOTP time step: a code is rejected unless its step is newer (replay protection).
  totpLastStep       Int?
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  backupCodes        BackupCode[]
}

model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Kept after a user is deleted on purpose (userId has no relation).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String   @default("")
  action    String
  success   Boolean  @default(true)
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([userId])
}

/// DB-backed rate limiting / lockouts (works on serverless where memory is not shared).
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model PageSection {
  id        String   @id @default(cuid())
  page      String
  key       String
  content   Json
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, key])
  @@index([page, order])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   @default("product")
  status      String   @default("")
  summary     String   @default("")
  description String?
  image       String?
  gradient    String?
  ctaLabel    String?
  ctaHref     String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  extra       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  company   String?
  quote     String
  avatar    String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  bio       String   @default("")
  photo     String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   @default("")
  excerpt     String   @default("")
  body        String?
  image       String?
  author      String   @default("MAOUAJ Team")
  publishedAt DateTime @default(now())
  dateLabel   String?
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  email        String
  phone        String?
  organisation String?
  interest     String?
  message      String
  consent      Boolean    @default(false)
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())

  @@index([status, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model SiteSettings {
  id        Int      @id @default(1)
  siteName  String   @default("MAOUAJ Technology")
  tagline   String   @default("")
  logoUrl   String?
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  socials   Json     @default("{}")
  nav       Json     @default("[]")
  footer    Json     @default("{}")
  seo       Json     @default("{}")
  updatedAt DateTime @updatedAt
}
