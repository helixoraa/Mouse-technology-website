generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageSection {
  id        String   @id @default(cuid())
  page      String
  key       String
  content   Json
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, key])
  @@index([page, order])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   @default("product")
  status      String   @default("")
  summary     String   @default("")
  description String?
  image       String?
  gradient    String?
  ctaLabel    String?
  ctaHref     String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  extra       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  company   String?
  quote     String
  avatar    String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  bio       String   @default("")
  photo     String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   @default("")
  excerpt     String   @default("")
  body        String?
  image       String?
  author      String   @default("MAOUAJ Team")
  publishedAt DateTime @default(now())
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  email        String
  phone        String?
  organisation String?
  interest     String?
  message      String
  consent      Boolean    @default(false)
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())

  @@index([status, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model SiteSettings {
  id        Int      @id @default(1)
  siteName  String   @default("MAOUAJ Technology")
  tagline   String   @default("")
  logoUrl   String?
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  socials   Json     @default("{}")
  nav       Json     @default("[]")
  footer    Json     @default("{}")
  seo       Json     @default("{}")
  updatedAt DateTime @updatedAt
}
