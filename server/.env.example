NODE_ENV=development
PORT=4000
# Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooled) one used by migrations.
# Locally both can be the same database.
DATABASE_URL=postgresql://maouaj:maouaj@localhost:5432/maouaj?schema=public
DIRECT_URL=postgresql://maouaj:maouaj@localhost:5432/maouaj?schema=public
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# First admin, created by the seed with "must change password" on first login.
ADMIN_EMAIL=admin@maouaj.example
ADMIN_PASSWORD=ChangeMe123!
# Storage: "local" (default) writes to ./uploads. "blob" uses Vercel Blob (production on Vercel) and needs BLOB_READ_WRITE_TOKEN.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# BLOB_READ_WRITE_TOKEN=
