# Production environment for Vercel (Project -> Settings -> Environment Variables), or in .env.production.local after `vercel env pull`.
# Never commit real values. The server REFUSES TO START in production when a secret below is missing or still an example value.

NODE_ENV=production

# --- Database: Neon (add it from the Vercel Storage tab; the integration sets these for you) ---
# Pooled connection (used by the running site). Must include pgbouncer=true:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) connection, used only by migrations (`npm run prod:deploy`):
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Secrets (generate each one yourself) ---
# Signs session cookies and the short-lived login tokens. 32+ characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Encrypts every user's Google Authenticator secret in the database. EXACTLY 64 hex characters.
# Generate it ONCE and never change it afterwards (changing it breaks every enrolled 2FA).
#   openssl rand -hex 32
#   (no openssl? node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOTP_ENCRYPTION_KEY=

# --- First administrator (created by the seed; must change the password and set up 2FA on first login) ---
ADMIN_EMAIL=you@yourcompany.com
# 12+ characters, not an example value. Generate one:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=

# --- Site URL (CORS allows only this origin). Use the Vercel URL first, then your custom domain ---
CLIENT_URL=https://your-project.vercel.app

# --- File uploads: Vercel Blob (add it from the Vercel Storage tab; it sets the token) ---
STORAGE_DRIVER=blob
BLOB_READ_WRITE_TOKEN=
