{
  "name": "maouaj-technology",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "db:seed": "npm run db:seed -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:generate": "npm run db:generate -w server",
    "vercel-build": "npm run db:generate -w server && npm run build -w client",
    "admin:reset": "npm run admin:reset -w server --",
    "prod:deploy": "npm run prod:db:deploy -w server",
    "prod:seed": "npm run prod:db:seed -w server",
    "prod:migrate-media": "npm run prod:migrate:media -w server --",
    "prod:admin-reset": "npm run prod:admin:reset -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "eslint": "^9.14.0",
    "@eslint/js": "^9.14.0",
    "typescript-eslint": "^8.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
