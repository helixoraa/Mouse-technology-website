# Used by `docker compose up --build`. Copy to .env and edit:   cp .env.docker.example .env
# Compose runs the API with NODE_ENV=production, and the API REFUSES TO START if JWT_SECRET or
# ADMIN_PASSWORD is still an example value. Generate real ones, e.g.:   openssl rand -base64 48
# Local development without Docker uses server/.env and client/.env instead.
JWT_SECRET=
ADMIN_EMAIL=admin@maouaj.example
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Public origin of the site (CORS + cookies). Change for a real domain.
CLIENT_URL=http://localhost:8080
# Plain http (local compose) needs false. Set to true (or remove) behind HTTPS.
COOKIE_SECURE=false
